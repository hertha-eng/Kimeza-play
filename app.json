{
  "expo": {
    "name": "Kimeza Play",
    "slug": "kimeza",
    "scheme": "kimezaplay",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.kimezaplay.app"
    },
    "android": {
      "package": "org.kimezaplay.app",
      "adaptiveIcon": {
        "backgroundColor": "#102A24"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "Kimeza Play",
      "shortName": "Kimeza"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "8e774152-5312-49bc-9b44-83121edf4872"
      }
    }
  }
}